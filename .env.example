# Copy to .env and fill in. Delete the LLM_* lines to run rules-only (offline).
# Any OpenAI-compatible endpoint works; LLM_PROVIDER presets fill in the base URL.

# --- Gemini (free key: https://aistudio.google.com/apikey) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_MODEL=<model name>
# LLM_API_KEY=sk-...

# --- Anthropic Claude ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# LLM_API_KEY=sk-ant-...

# --- Groq / OpenRouter: same pattern with LLM_PROVIDER=groq or openrouter ---

# --- Local Ollama (no key) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2

# --- Any other OpenAI-compatible endpoint ---
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_MODEL=<model name>
# LLM_API_KEY=...

# --- Optional ---
# LLM_JSON_MODE=json_object   # none (default) | json_object | json_schema
# LLM_TIMEOUT=30
# BI_USE_LLM=0                # force rules-only even if configured
